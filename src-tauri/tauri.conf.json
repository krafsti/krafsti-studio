{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Krafsti Studio",
  "version": "1.34.0",
  "identifier": "com.krafsti.studio",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run preparar"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Krafsti Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "maximized": true,
        "dragDropEnabled": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "deb"],
    "createUpdaterArtifacts": true,
    "publisher": "Krafsti",
    "copyright": "© 2026 Krafsti",
    "category": "GraphicsAndDesign",
    "shortDescription": "Herramienta de diseño para láser e impresora UV",
    "longDescription": "Krafsti Studio: vectorizar imágenes, quitar fondos y componer diseños con capas, textos y formas para cortadoras láser e impresoras UV.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": { "languages": ["Spanish"], "installMode": "currentUser" }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZGNjY4OTY3MDRBQzEwMUEKUldRYUVLd0VaNGxtLzFwY1pLR1BxemdUOTZPaG5ZbFduNlZRRWdoR29UZS9TdnRWdUptWTlaY2IK",
      "endpoints": ["https://github.com/krafsti/krafsti-studio/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
